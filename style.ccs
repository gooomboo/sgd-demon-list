:root {
  --bg: #f4f5f7;
  --card-bg: #ffffff;
  --text-main: #333333;
  --text-muted: #777777;
  --border: #e0e0e0;
  --accent-blue: #0078d7;
  --hover-blue: #005a9e;
  --accent-green: #1a9850;
  --record-bg: #0088cc;
  --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

[data-theme="dark"] {
  --bg: #121212;
  --card-bg: #1e1e1e;
  --text-main: #e6e6e6;
  --text-muted: #a3a3a3;
  --border: #333333;
  --accent-blue: #38bdf8;
  --hover-blue: #0ea5e9;
  --accent-green: #4ade80;
  --record-bg: #1560a8;
}

* { box-sizing: border-box; }

body {
  font-family: var(--font-stack);
  background-color: var(--bg);
  color: var(--text-main);
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  transition: background-color 0.2s, color 0.2s;
}

.navbar {
  width: 100%;
  background: var(--card-bg);
  border-bottom: 1px solid var(--border);
  padding: 12px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  flex-wrap: wrap;
  gap: 12px;
}

.nav-links, .nav-controls {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-wrap: wrap;
}

.nav-btn {
  background: none;
  color: var(--text-muted);
  border: none;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  transition: color 0.2s;
  text-decoration: none;
  padding: 6px 8px;
  font-family: inherit;
}

.nav-btn.active, .nav-btn:hover { color: var(--text-main); }
.submit-btn { color: var(--accent-blue) !important; font-weight: 700; }

.audio-controls {
  display: flex;
  gap: 6px;
  align-items: center;
  background: var(--bg);
  padding: 4px 10px;
  border-radius: 20px;
  border: 1px solid var(--border);
}

.icon-btn, .music-upload-btn {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 1.1rem;
  color: var(--text-main);
  padding: 2px 4px;
  display: flex;
  align-items: center;
}

.music-upload-btn {
  font-size: 0.85rem;
  font-weight: bold;
  margin-right: 4px;
  cursor: pointer;
}

.icon-btn:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}

.container {
  width: 100%;
  max-width: 900px;
  padding: 30px 15px;
}

.search-bar {
  width: 100%;
  padding: 12px 16px;
  font-size: 1rem;
  border: 1px solid var(--border);
  border-radius: 6px;
  margin-bottom: 20px;
  outline: none;
  font-family: inherit;
  background: var(--card-bg);
  color: var(--text-main);
}

.search-bar:focus {
  border-color: var(--accent-blue);
}

.level-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  margin-bottom: 16px;
  border-radius: 6px;
  overflow: hidden;
  cursor: pointer;
  transition: transform 0.15s, border-color 0.15s;
  display: flex;
  align-items: stretch;
}

.level-card:hover {
  transform: translateY(-2px);
  border-color: var(--accent-blue);
}

.card-banner {
  width: 200px;
  min-height: 120px;
  object-fit: cover;
  background: #000;
}

.card-info {
  padding: 16px 20px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex-grow: 1;
}

.card-title {
  font-size: 1.3rem;
  font-weight: 700;
  margin: 0 0 4px 0;
}

.rank {
  color: var(--accent-blue);
}

.card-author, .card-points {
  font-size: 0.9rem;
  color: var(--text-muted);
  margin: 0 0 2px 0;
}

.detail-view {
  background: var(--card-bg);
  padding: 30px;
  border: 1px solid var(--border);
  border-radius: 6px;
}

.detail-header {
  text-align: center;
  margin-bottom: 20px;
}

.detail-header h1 {
  font-size: 2rem;
  margin: 0 0 6px 0;
  color: var(--accent-blue);
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 15px;
}

.detail-header h1 span {
  font-size: 1rem;
  color: var(--text-muted);
  cursor: pointer;
  background: var(--bg);
  padding: 4px 10px;
  border-radius: 4px;
  border: 1px solid var(--border);
}

.detail-subtitle {
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-muted);
  padding-bottom: 15px;
  border-bottom: 1px solid var(--border);
}

.card-image {
  width: 100%;
  max-width: 550px;
  margin: 0 auto 25px auto;
  display: block;
  border-radius: 6px;
  border: 1px solid var(--border);
  max-height: 300px;
  object-fit: cover;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 15px;
  text-align: center;
  margin-bottom: 25px;
  background: var(--bg);
  padding: 15px;
  border-radius: 6px;
  border: 1px solid var(--border);
}

.stat-box h4 {
  margin: 0 0 4px 0;
  font-size: 0.85rem;
  text-transform: uppercase;
  color: var(--text-muted);
}

.stat-box p {
  margin: 0;
  font-size: 1.1rem;
  font-weight: bold;
  color: var(--text-main);
}

.records-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 10px;
}

.records-table th {
  background: var(--accent-blue);
  color: #fff;
  padding: 10px 14px;
  text-align: left;
  font-size: 0.9rem;
}

.records-table td {
  padding: 10px 14px;
  border-bottom: 1px solid var(--border);
  font-size: 0.95rem;
}

.lb-row {
  display: flex;
  align-items: center;
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
  background: var(--card-bg);
  border-radius: 4px;
  margin-bottom: 6px;
}

.lb-name {
  flex-grow: 1;
  font-weight: 600;
  margin-left: 15px;
}

.mod-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 16px 20px;
  margin-bottom: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mod-card .mod-name {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--accent-blue);
}

.mod-card .mod-role {
  color: var(--text-muted);
  font-size: 0.95rem;
}

.roulette-box {
  text-align: center;
  padding: 30px;
}

.roulette-level {
  background: var(--bg);
  border: 1px solid var(--border);
  padding: 30px;
  margin: 20px 0;
  border-radius: 8px;
}

.btn {
  background: var(--card-bg);
  border: 1px solid var(--border);
  padding: 10px 20px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  border-radius: 6px;
  transition: 0.15s;
  font-family: inherit;
  color: var(--text-main);
  margin: 5px;
}

.btn:hover { background: var(--bg); }
.btn-primary { background: var(--accent-blue); color: white; border-color: var(--accent-blue); }
.btn-primary:hover { background: var(--hover-blue); }
